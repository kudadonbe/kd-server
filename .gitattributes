# Normalize all text files to LF in the repo AND on checkout.
# `eol=lf` overrides a station's core.autocrlf, so Windows and macOS
# checkouts are byte-identical — no phantom "modified" files, no gofmt
# CRLF failures. This is the cross-station guard; do not weaken it.
* text=auto eol=lf

# Explicit LF for the languages/formats we edit, so intent is obvious.
*.go    text eol=lf
*.mod   text eol=lf
*.sum   text eol=lf
*.md    text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.json  text eol=lf
*.templ text eol=lf
*.css   text eol=lf
*.js    text eol=lf
*.sh    text eol=lf
*.env   text eol=lf
*.rest  text eol=lf

# Binary assets — never touch line endings.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.pdf   binary
*.ico   binary
*.woff  binary
*.woff2 binary

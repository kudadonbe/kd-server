MONGO_URI=mongodb://localhost:27017
MONGO_DB=kdserver
JWT_SIGNING_KEY=dev-secret-change-me
PORT=18080
KD_ADMIN_USERNAME=admin
KD_ADMIN_PASSWORD=generate-a-strong-random-password

# Shared AI service (optional; feature disabled when AI_ENCRYPTION_KEY is unset).
# AI_ENCRYPTION_KEY encrypts stored provider API keys at rest — base64 of 32 bytes,
# e.g. generate with:  openssl rand -base64 32
AI_ENCRYPTION_KEY=
# Optional server-wide fallback Anthropic key used when a tenant has not set its own.
ANTHROPIC_API_KEY=
# Optional default model (per-credential overrides win). Default: claude-sonnet-5
AI_DEFAULT_MODEL=

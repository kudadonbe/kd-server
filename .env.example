MONGO_URI=mongodb://localhost:27017
MONGO_DB=kdserver
JWT_SIGNING_KEY=dev-secret-change-me
PORT=18080
KD_ADMIN_USERNAME=admin
KD_ADMIN_PASSWORD=generate-a-strong-random-password
# Admin console branding (optional). Shown in the sidebar/topbar and env badge;
# editable live from Settings › Branding. Defaults: "KD-Server" / "dev".
KD_SERVER_NAME=KD-Server
KD_ENV=dev

# --- AI (optional) ---------------------------------------------------------
# Set your Anthropic key to turn on AI features (document extraction, etc.).
ANTHROPIC_API_KEY=
# Default model (optional). Default: claude-sonnet-5
AI_DEFAULT_MODEL=
# Optional: only needed to store keys via the admin/tenant API (encrypted).
# Not required when ANTHROPIC_API_KEY is set. See docs/ if you need it.
AI_ENCRYPTION_KEY=

MONGO_URI=mongodb://localhost:27017
MONGO_DB=kdserver
JWT_SIGNING_KEY=dev-secret-change-me
PORT=18080
KD_ADMIN_USERNAME=admin
KD_ADMIN_PASSWORD=generate-a-strong-random-password

# --- AI (optional) ---------------------------------------------------------
# Set ANTHROPIC_API_KEY to turn on AI features (document extraction, etc.).
# This key alone is enough; no encryption key required.
ANTHROPIC_API_KEY=
# Default model. Per-credential overrides win. Default: claude-sonnet-5
AI_DEFAULT_MODEL=
# Only needed to STORE keys via the admin console or tenant API (per-tenant or
# admin-paired keys, encrypted at rest). NOT required when you use
# ANTHROPIC_API_KEY above. Base64 of 32 bytes, e.g.:
#   PowerShell: [Convert]::ToBase64String([System.Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
#   bash:       openssl rand -base64 32
AI_ENCRYPTION_KEY=
